# ============================================================
# Firebase Configuration for Google Authentication
# Obtain these from: https://console.firebase.google.com/
# Project Settings > General > Your Apps > Web App (Firebase SDK snippet > Config)
# ============================================================

VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# ============================================================
# Backblaze B2 Cloud Storage Configuration
# Obtain these from: https://secure.backblaze.com/b2_buckets.htm
#
# 1. Bucket Name: The exact name of your Backblaze B2 bucket
# 2. Bucket ID: Found in your Backblaze bucket list
# 3. Endpoint: Found under bucket details (e.g., s3.us-west-004.backblazeb2.com)
# 4. Region: The region code from your endpoint (e.g., us-west-004, us-east-005)
# 5. Key ID: Your Backblaze Application Key ID (keyID)
# 6. Application Key: Your Backblaze Secret Key (applicationKey)
# ============================================================

# Standard / Backend variables
B2_BUCKET_NAME=your-bucket-name
B2_BUCKET_ID=your-bucket-id
B2_REGION=us-west-004
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_KEY_ID=your-application-key-id
B2_APPLICATION_KEY=your-application-key
B2_PUBLIC_URL=https://f004.backblazeb2.com/file/your-bucket-name

# Frontend / Vite variables (Accessible via import.meta.env.VITE_B2_...)
VITE_B2_BUCKET_NAME=your-bucket-name
VITE_B2_REGION=us-west-004
VITE_B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
VITE_B2_KEY_ID=your-application-key-id
VITE_B2_APPLICATION_KEY=your-application-key
VITE_B2_PUBLIC_URL=https://f004.backblazeb2.com/file/your-bucket-name
